# Project
PROJECT_NAME=audex_dev
COMPOSE_PROJECT_NAME=audex_dev

# Auth
PUBLIC_CLIENT_URL=http://localhost:3700
PUBLIC_SERVER_URL=http://localhost:3200

# Server
# ! host should be without any slashes at the end
SERVER_HOST=http://localhost
SERVER_PORT=3200

PUBLIC_MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL="false"

# Client
# ! host should be without any slashes at the end
CLIENT_HOST=http://localhost
CLIENT_PORT=4000

# DB
POSTGRES_USER=root
POSTGRES_PASSWORD=admin
POSTGRES_DB=audex_dev
POSTGRES_PORT=5434

# MiniIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=rootroot
FILESTORAGE_HOST=localhost
MINIO_API_PORT=8250
MINIO_UI_PORT=8251

#Auth
AUTH_ISSUER=audex
AUTH_AUDIENCE=audex
AUTH_SECRET=audex

# Infrastructure Manager
INFRA_MANAGER_PORT=5050
INFRA_MANAGER_AUTH_KEY=dev-infra-secret-key-321